{
  "name": "mirage-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "A public, playable benchmark for foundation models building GTA-inspired browser games set in San Francisco.",
  "license": "Apache-2.0",
  "homepage": "https://mirage-kshr.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSHR-AI/Mirage.git"
  },
  "bugs": {
    "url": "https://github.com/KSHR-AI/Mirage/issues"
  },
  "keywords": [
    "benchmark",
    "browser-game",
    "coding-agents",
    "foundation-models",
    "threejs"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "catalog:generate": "node scripts/generate-benchmark-catalog.mjs",
    "catalog:check": "node scripts/generate-benchmark-catalog.mjs --check",
    "predev": "pnpm catalog:generate",
    "dev": "next dev",
    "prebuild": "pnpm catalog:generate",
    "build": "next build",
    "start": "next start",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:security": "pnpm audit --audit-level=high --ignore GHSA-mh99-v99m-4gvg",
    "format:check": "prettier --check .openai app benchmark build scripts worker .github README.md CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md eslint.config.mjs next.config.ts package.json pnpm-workspace.yaml tsconfig.json vercel.json vite.config.ts vitest.config.ts",
    "check": "pnpm catalog:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm audit:security && pnpm build"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
