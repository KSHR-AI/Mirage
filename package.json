{
  "name": "mirage-model-demos",
  "version": "0.1.0",
  "private": true,
  "description": "A playable benchmark for coding-model attempts to build GTA in San Francisco.",
  "license": "Apache-2.0",
  "homepage": "https://mirageml.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSHR-AI/Mirage.git"
  },
  "bugs": {
    "url": "https://github.com/KSHR-AI/Mirage/issues"
  },
  "keywords": [
    "benchmark",
    "gta-in-sf",
    "browser-game",
    "coding-agents",
    "foundation-models"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:submissions": "vitest run --config scripts/submissions/vitest.config.mjs",
    "submissions:validate": "node scripts/submissions/validate-submissions.mjs --mode all",
    "audit:security": "pnpm audit --audit-level=high --ignore GHSA-mh99-v99m-4gvg",
    "format:check": "prettier --check .github app docs scripts submissions AGENTS.md README.md TODO.md CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md eslint.config.mjs next.config.ts package.json pnpm-workspace.yaml tsconfig.json vercel.json vitest.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm submissions:validate && pnpm audit:security && pnpm build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
