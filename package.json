{
  "name": "mirage-model-demos",
  "version": "0.1.0",
  "private": true,
  "description": "A gallery of playable browser games built end-to-end by coding models.",
  "license": "Apache-2.0",
  "homepage": "https://mirageml.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSHR-AI/Mirage.git"
  },
  "bugs": {
    "url": "https://github.com/KSHR-AI/Mirage/issues"
  },
  "keywords": [
    "model-demos",
    "browser-game",
    "coding-agents",
    "foundation-models"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:publishing": "vitest run --config scripts/publishing/vitest.config.mjs",
    "publishing:contract": "node .github/actions/publishing-contract/check.mjs",
    "audit:security": "pnpm audit --audit-level=high --ignore GHSA-mh99-v99m-4gvg",
    "format:check": "prettier --check .github app docs scripts submissions AGENTS.md README.md TODO.md CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md eslint.config.mjs next.config.ts package.json pnpm-workspace.yaml tsconfig.json vercel.json vitest.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm publishing:contract && pnpm audit:security && pnpm build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
